# ---- Trading mode ----
LIVE_TRADING_ENABLED=false              # one of three locks for LIVE; must be true to switch out of PAPER

# ---- IBKR ----
IBKR_PAPER_HOST=127.0.0.1
IBKR_PAPER_PORT=4002
IBKR_PAPER_CLIENT_ID=11
IBKR_LIVE_HOST=127.0.0.1
IBKR_LIVE_PORT=4001
IBKR_LIVE_CLIENT_ID=12

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=                    # comma-separated channel IDs to listen on

# ---- Anthropic (Claude Haiku 4.5 LLM fallback parser) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Unusual Whales ----
UW_API_KEY=
UW_BASE_URL=https://api.unusualwhales.com
FLOW_FAIL_MODE=inconclusive_passes      # inconclusive_passes | fail_closed

# ---- Parser ----
PARSE_MIN_CONFIDENCE=0.85

# ---- Risk ----
TRADING_HOURS_START=09:35
TRADING_HOURS_END=15:55
DAILY_LOSS_LIMIT=-500
MAX_CONCURRENT_POSITIONS=5
PER_TRADE_DOLLAR_CAP=500
HARD_CONTRACT_CAP=10
ORDERS_PER_HOUR=20
SLIPPAGE_TOLERANCE=0.02
DUPLICATE_WINDOW_SECONDS=60

# ---- Scanner ----
SCANNER_ENABLED=true
SCANNER_WATCHLIST=SPY,QQQ,AAPL,TSLA,NVDA,AMD,MSFT,META,AMZN,GOOGL
SCANNER_DAILY_TRADE_CAP=                # optional per-source cap; blank = same as global

# ---- Dashboard ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# ---- Storage ----
DB_PATH=./data/xecute.db
LOG_DIR=./logs

# ---- Dev toggles ----
DRY_RUN=false                           # runs everything except actual order submission
